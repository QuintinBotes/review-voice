{
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Semgrep OSS",
          "semanticVersion": "1.90.0",
          "rules": [
            {
              "id": "python.lang.security.audit.eval-detected",
              "name": "python.lang.security.audit.eval-detected",
              "shortDescription": { "text": "Detected the use of eval()" },
              "fullDescription": { "text": "Detected the use of eval(). eval() can be dangerous if used to evaluate dynamic content." },
              "defaultConfiguration": { "level": "error" },
              "properties": { "precision": "very-high", "tags": ["security"] }
            },
            {
              "id": "python.lang.best-practice.open-never-closed",
              "name": "python.lang.best-practice.open-never-closed",
              "shortDescription": { "text": "file object opened without corresponding close" },
              "fullDescription": { "text": "file object opened without corresponding close" },
              "defaultConfiguration": { "level": "warning" },
              "properties": { "precision": "medium", "tags": ["best-practice"] }
            },
            {
              "id": "python.lang.maintainability.useless-ifelse",
              "name": "python.lang.maintainability.useless-ifelse",
              "shortDescription": { "text": "Detected an if block that checks for the same condition on both branches" },
              "fullDescription": { "text": "Detected an if block that checks for the same condition on both branches" },
              "defaultConfiguration": { "level": "note" },
              "properties": { "precision": "medium", "tags": ["maintainability"] }
            }
          ]
        }
      },
