@@ -1,3 +1,25 @@
+[Fact]
+public async Task Submit_order_contract() {
+    var provider = new CopiedOrderProvider();
+
+    await provider.VerifyInteraction(new ProviderInteraction {
+        Given = "an order already exists",
+        Request = new ContractRequest {
+            Method = "POST",
+            Path = "/orders",
+            Headers = new Dictionary<string, string> {
+                ["Idempotency-Key"] = "repeat-key",
+            },
+        },
+        Response = new ContractResponse {
+            Status = 200,
+            Body = new {
+                id = Guid.NewGuid().ToString(),
+                state = Match.Type("Accepted"),
+                parentId = (string?)null,
+            },
+        },
+    });
+}
