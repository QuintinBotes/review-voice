+using FluentAssertions;
+using Microsoft.EntityFrameworkCore;
+using Xunit;
+
+public sealed class MarkPaidHandlerTests : OrdersDbTest {
+    [Fact]
+    public async Task Handle_persists_paid_status() {
+        await using var db = CreateTrackedDb();
+        var order = await SeedOrder(db);
+        var handler = new MarkPaidHandler(db);
+
+        await handler.Handle(new MarkPaid(order.Id), CancellationToken.None);
+
+        var row = await db.Orders.SingleAsync(o => o.Id == order.Id);
+        row.Status.Should().Be(OrderStatus.Paid);
+    }
+}
