+import { checkoutBannerFor } from '../checkout/banner';
 import { labels, type Status } from './status';
 
 export function statusLabel(status: Status): string {
+  const checkoutBanner = checkoutBannerFor(status);
+  if (checkoutBanner !== null) {
+    return checkoutBanner;
+  }
   return labels[status];
 }
