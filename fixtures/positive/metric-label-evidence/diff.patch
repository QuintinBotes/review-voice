--- /dev/null
+++ b/src/dispatch.ts
@@ -0,0 +1,20 @@
+import { metrics } from './metrics';
+import type { Request } from './request';
+
+export async function dispatch(request: Request, cancellation: AbortSignal) {
+  const all = await request.loadTasks();
+  metrics.countTasks(all.length);
+
+  try {
+    const selected = all.filter((task) => task.enabled);
+    const result = await request.send(selected, cancellation);
+    metrics.record({ outcome: result.reason ?? 'sync_lag' });
+    metrics.record({ outcome: 'ok' });
+  } catch (error) {
+    if (cancellation.aborted) {
+      metrics.record({ outcome: 'failed' });
+      return;
+    }
+    throw error;
+  }
+}
