--- /dev/null
+++ b/src/scopes.ts
@@ -0,0 +1,16 @@
+export const Scope = { None: 0, Read: 1, Write: 2 } as const;
+type ScopeValue = number;
+
+function parseScope(name: string): ScopeValue {
+  if (name === 'read') return Scope.Read;
+  if (name === 'write') return Scope.Write;
+  throw new Error(`Unknown scope: ${name}`);
+}
+
+export function parseScopes(raw: string): ScopeValue {
+  return raw
+    .split(',')
+    .filter(Boolean)
+    .reduce((value, name) => value | parseScope(name), Scope.None);
+}
