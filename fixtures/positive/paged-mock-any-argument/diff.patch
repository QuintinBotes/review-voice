+using FluentAssertions;
+using Moq;
+using Xunit;
+
+public sealed class PageReaderTests {
+    [Fact]
+    public async Task ReadAll_reads_each_page() {
+        var first = new Page(new[] { new Item("first") }, "cursor-2");
+        var second = new Page(new[] { new Item("second") }, null);
+        var client = new Mock<ICatalogClient>();
+        client.SetupSequence(c => c.GetPageAsync(
+                It.IsAny<string?>(), It.IsAny<int>(), It.IsAny<CancellationToken>()))
+            .ReturnsAsync(first)
+            .ReturnsAsync(second);
+
+        var items = await new PageReader(client.Object).ReadAllAsync(CancellationToken.None);
+
+        items.Should().NotBeEmpty();
+    }
+}
