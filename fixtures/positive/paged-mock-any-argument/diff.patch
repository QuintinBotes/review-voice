+public sealed class PageReader(ICatalogClient client) {
+    public async Task<IReadOnlyList<Item>> ReadAllAsync(CancellationToken cancellationToken) {
+        var items = new List<Item>();
+        string? cursor = null;
+        Page page;
+        do {
+            page = await client.GetPageAsync(cursor, 100, cancellationToken);
+            items.AddRange(page.Items);
+            cursor = page.NextCursor;
+        } while (cursor is not null);
+        return items;
+    }
+}
