+[Authorize(Policy = "AnyAuthenticatedService")]
+[ApiController]
+[Route("accounts")]
+public sealed class AccountsController : ControllerBase
+{
+    [HttpGet("bulk")]
+    public async Task<IReadOnlyList<AccountStatusDto>> GetBulk()
+    {
+        var accounts = await accountStore.ReadAll();
+        return accounts
+            .Select(account => new AccountStatusDto(account.Id, account.Status, account.Note, account.OwnerDisplayName))
+            .ToList();
+    }
+}
+
+public sealed record AccountStatusDto(
+    string Id,
+    string Status,
+    string Note,
+    string OwnerDisplayName);
