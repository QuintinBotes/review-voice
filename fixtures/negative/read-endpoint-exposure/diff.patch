+using Microsoft.AspNetCore.Authorization;
+using Microsoft.AspNetCore.Mvc;
+
+[Authorize(Policy = "AccountStatusReader")]
+[ApiController]
+[Route("accounts")]
+public sealed class AccountsController(IAccountStore accountStore) : ControllerBase
+{
+    [HttpGet("bulk")]
+    public async Task<IReadOnlyList<AccountStatusDto>> GetBulk()
+    {
+        var accounts = await accountStore.ReadAll();
+        return accounts.Select(account => new AccountStatusDto(account.Id, account.Status)).ToList();
+    }
+}
+
+public sealed record AccountStatusDto(string Id, string Status);
