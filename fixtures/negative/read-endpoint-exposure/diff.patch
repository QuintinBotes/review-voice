+using System.Net;
+using System.Net.Http.Json;
+using FluentAssertions;
+using Xunit;
+
+public sealed class AccountStatusEndpointTests(ApiClientFactory clientFactory) : IClassFixture<ApiClientFactory>
+{
+    [Fact]
+    public async Task GetBulk_returns_forbidden_without_a_role()
+    {
+        var client = clientFactory.WithoutRole();
+        var response = await client.GetAsync("/accounts/bulk");
+        response.StatusCode.Should().Be(HttpStatusCode.Forbidden);
+    }
+
+    [Fact]
+    public async Task GetBulk_returns_forbidden_for_a_writer_role()
+    {
+        var clientWithWriterRole = clientFactory.ForRole("AccountWriter");
+        var response = await clientWithWriterRole.GetAsync("/accounts/bulk");
+        response.StatusCode.Should().Be(HttpStatusCode.Forbidden);
+    }
+
+    [Fact]
+    public async Task GetBulk_returns_each_account_status_for_a_reader_role()
+    {
+        var clientWithReaderRole = clientFactory.ForRole("AccountStatusReader");
+        var response = await clientWithReaderRole.GetAsync("/accounts/bulk");
+        response.StatusCode.Should().Be(HttpStatusCode.OK);
+        var statuses = await response.Content.ReadFromJsonAsync<AccountStatusDto[]>();
+        statuses.Should().Equal(new AccountStatusDto("account-1", "Active"), new AccountStatusDto("account-2", "Suspended"));
+    }
+}
