+using Xunit;
+
+public sealed class SubmitOrderContractTests {
+    [Fact]
+    public async Task Submit_order_honors_idempotency_key() {
+        var provider = ProviderHarness.For<OrderApi>();
+
+        await provider.VerifyInteraction(new ProviderInteraction {
+            Given = "order with idempotency key repeat-key has id order-42",
+            Request = new ContractRequest {
+                Method = "POST",
+                Path = "/orders",
+                Headers = new Dictionary<string, string> {
+                    ["Idempotency-Key"] = "repeat-key",
+                },
+            },
+            Response = new ContractResponse {
+                Status = 200,
+                Body = new {
+                    id = "order-42",
+                    state = Match.OneOf("Accepted", "Pending"),
+                    parentId = "parent-7",
+                    createdAt = Match.Iso8601DateTime(),
+                },
+            },
+        });
+    }
+}
