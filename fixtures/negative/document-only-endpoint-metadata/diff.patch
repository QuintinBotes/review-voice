+public static class ItemsEndpoints
+{
+    public static void Map(WebApplication app)
+    {
+        app.MapPut("/items/{id}", Update)
+            .WithOpenApi()
+            .AddEndpointFilter<JsonOnlyFilter>();
+    }
+
+    // Takes the raw request, since a bound body would have the framework answer 415 before the filter runs.
+    private static Task<IResult> Update(HttpRequest request) => Task.FromResult(Results.Ok());
+}
+
+public sealed class JsonOnlyFilter : IEndpointFilter
+{
+    public ValueTask<object?> InvokeAsync(EndpointFilterInvocationContext context, EndpointFilterDelegate next)
+    {
+        if (!context.HttpContext.Request.HasJsonContentType())
+            return ValueTask.FromResult<object?>(Results.BadRequest(new { error = "json_required" }));
+        return next(context);
+    }
+}
