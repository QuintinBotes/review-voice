{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/QuintinBotes/review-voice/schemas/candidate.schema.json",
  "title": "Candidate findings",
  "description": "Output of the diff-analyst agent. An empty array is a valid and expected result.",
  "type": "object",
  "required": [
    "candidates"
  ],
  "additionalProperties": false,
  "properties": {
    "candidates": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "required": [
          "candidate_id",
          "path",
          "line",
          "category",
          "severity",
          "claim",
          "failure_mode",
          "evidence",
          "technical_confidence"
        ],
        "additionalProperties": false,
        "properties": {
          "candidate_id": {
            "type": "string",
            "pattern": "^cand_[0-9]{3,}$"
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "category": {
            "$ref": "finding-category.schema.json",
            "description": "Kind of consequence. The CLI combines it with computed reach; agents must not supply a reach field."
          },
          "severity": {
            "enum": [
              "blocking",
              "important",
              "minor",
              "nit",
              "question"
            ],
            "description": "Requested tier retained for audit. The CLI derives the reported tier from category and computed reach."
          },
          "claim": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "failure_mode": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "Specific observations from the diff, project context, or static analysis. A candidate without evidence is rejected."
          },
          "suggested_fix": {
            "type": "string",
            "maxLength": 300
          },
          "fix_confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "Optional analyst confidence retained for audit. The verifier's separate fix confidence controls rendering."
          },
          "technical_confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "anchor": {
            "enum": [
              "stale-consumer"
            ],
            "description": "Only for unchanged code the change made wrong (a caller, a doc, a config elsewhere). path and line are then the consumer, and caused_by names the changed line. Posted in the review body, never inline."
          },
          "caused_by": {
            "type": "object",
            "required": [
              "path",
              "line"
            ],
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "line": {
                "type": "integer",
                "minimum": 1
              }
            },
            "description": "With anchor stale-consumer: the added line or deletion site that made the consumer wrong."
          }
        }
      }
    }
  }
}
