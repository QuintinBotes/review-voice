{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/QuintinBotes/review-voice/schemas/policy.schema.json",
  "title": "Policy artifact",
  "description": "A versioned, approvable, rollbackable policy. Every inferred rule must carry provenance; a rule that cannot show its evidence is a bug.",
  "type": "object",
  "required": ["policy_id", "version", "scope", "generated_at", "active", "policy", "provenance"],
  "additionalProperties": false,
  "properties": {
    "policy_id": { "type": "string" },
    "version": { "type": "integer", "minimum": 0 },
    "scope": {
      "type": "object",
      "required": ["type", "key"],
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["global", "repository", "path", "language"] },
        "key": { "type": "string" }
      }
    },
    "generated_at": { "type": "string", "format": "date-time" },
    "approved_at": {
      "type": ["string", "null"],
      "format": "date-time",
      "description": "Null until the owner approves. An unapproved policy is never active."
    },
    "active": { "type": "boolean" },

    "policy": {
      "type": "object",
      "properties": {
        "voice": {
          "type": "object",
          "properties": {
            "tone": { "type": "array", "items": { "type": "string" } },
            "max_findings": { "type": "integer", "minimum": 0, "maximum": 5 },
            "max_words_per_finding": { "type": "integer", "minimum": 1, "maximum": 40 },
            "max_total_words": { "type": "integer", "minimum": 1, "maximum": 180 },
            "no_findings_response": { "const": "No actionable findings." }
          }
        },
        "priorities": { "type": "array" },
        "suppressed_patterns": { "type": "array", "items": { "type": "string" } },
        "suppressions": {
          "type": "array",
          "description": "Structured suppressions, keyed by rule id, that `score` applies to a matching verified finding (docs/adr/0032). The prose in suppressed_patterns stays for readers. A rule id whose category is security, authorization, authentication, data_integrity or trust_boundary is refused at approval and ignored at scoring.",
          "items": {
            "type": "object",
            "required": ["rule_id"],
            "additionalProperties": false,
            "properties": {
              "rule_id": {
                "type": "string",
                "description": "`category:lane` or `category:lane:blocker_class`; the lane is `diff` for a finding with none.",
                "pattern": "^[^:\\s]+:[^:\\s]+(:[^\\s]+)?$"
              },
              "glob": {
                "type": ["string", "null"],
                "description": "Narrows the suppression to matching paths. Null means everywhere."
              },
              "reason": { "type": ["string", "null"], "description": "Why the owner's signals formed this rule." }
            }
          }
        },
        "forbidden_phrases": { "type": "array", "items": { "type": "string" } },
        "required_checks": { "type": "array", "items": { "type": "string" } }
      }
    },

    "provenance": {
      "type": "array",
      "description": "Per-rule evidence. Required for every inferred rule.",
      "items": {
        "type": "object",
        "required": ["rule", "evidence_event_ids", "confidence"],
        "additionalProperties": false,
        "properties": {
          "rule": { "type": "string" },
          "rule_id": {
            "type": "string",
            "description": "What the rule is about: `category:lane[:blocker_class]` (docs/adr/0032)."
          },
          "category": { "type": "string", "description": "The finding category of the rule id." },
          "evidence_event_ids": { "type": "array", "items": { "type": "string" } },
          "owner_signal_count": { "type": "integer", "minimum": 0 },
          "contradicting_signal_count": { "type": "integer", "minimum": 0 },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "most_recent_evidence_at": { "type": "string", "format": "date-time" }
        }
      }
    },

    "evaluation": {
      "type": "object",
      "properties": {
        "regression_suite_passed": { "type": "boolean" },
        "expected_finding_volume_delta": { "type": "number" },
        "measured_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
