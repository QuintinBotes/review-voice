# Normalise line endings so a Windows contributor does not produce a diff of
# the entire file, and so the bundle-drift check compares like with like.
* text=auto eol=lf

*.png binary
*.jpg binary
*.gif binary

# The CLI bundle is a build artifact that must be committed, because plugins
# install by git clone with no install step. Marking it generated collapses it
# in pull request review and keeps it out of language statistics - reviewers
# should read src/ and trust the drift check, not scroll past 3,000 machine
# generated lines.
plugins/review-voice/dist/review-voice.mjs linguist-generated=true

# Lockfiles are likewise reviewed by tooling, not by eye.
package-lock.json linguist-generated=true
